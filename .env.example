# Optional Google sign-in. Copy these public web-app values from Firebase
# Project settings > Your apps > SDK setup and configuration.
# Google sign-in stays disabled unless all four are set at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional existing Express backend (separate from Google authentication).
VITE_API_URL=

# Backend-only AI generation configuration (set securely on the Express
# service, not in VITE_ variables or browser code). The generator is disabled
# until all three model names and a rights-cleared PYQ or current-affairs source
# are configured and reviewed.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_GENERATOR_MODEL=
# AI_SOLVER_MODEL=
# AI_AUDITOR_MODEL=
# AI_TIMEOUT_MS=120000

# Optional, separate learner-facing AI Mentor. Configure only on the Node
# service; do not expose keys through VITE_ variables. Without a key/model,
# Mentor explains that it is unavailable; local related-PYQ lookup still works.
# MENTOR_BASE_URL=https://api.openai.com/v1
# MENTOR_API_KEY=
# MENTOR_MODEL=
# MENTOR_TIMEOUT_MS=20000
# Default false. Set true ONLY if the operator has verified that ALL published
# Bank content may be sent to this external AI provider. PYQ/CA permissions
# are checked individually regardless of this setting.
# MENTOR_ALLOW_BANK=false
